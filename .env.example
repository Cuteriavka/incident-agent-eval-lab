# Preparation-only path to the separately downloaded, pinned checkout.
# N00B never imports runner code from this path; it uses runner_code_view
# extracted from the verified archive.
CLOUDOPSBENCH_SOURCE_ROOT=C:/path/to/data/external/Cloud-OpsBench-41a881e...

# Prepared two-view tutorial workspace outside this repository.
CLOUDOPSBENCH_TUTORIAL_ROOT=C:/path/to/data/tutorial/cloudopsbench-41a881e-trainticket-service-1

# Local-only run outputs. Do not place this inside the public repository.
CLOUDOPSBENCH_RESULTS=C:/path/to/data/runs/cloud-opsbench

# N00B normally reads non-sensitive values from ignored .n00b.local.json.
# These environment names are optional overrides. Execution remains locked until
# an OpenAI-compatible API
# credential is supplied. N00A manual investigation never requires this value.
# Never put the credential value in this file.
CLOUDOPSBENCH_API_KEY_ENV=YOUR_PROVIDER_API_KEY
CLOUDOPSBENCH_API_BASE=https://your-provider.example/v1
CLOUDOPSBENCH_MODEL=your-model-name
CLOUDOPSBENCH_MAX_STEPS=6
